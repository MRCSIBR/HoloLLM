cat << 'EOF' > .gitignore
# Entorno virtual y dependencias locales
.venv/
env/
venv/
docs/conversacion.md

# Caches de Python y Pytest
__pycache__/
*.py[cod]
.pytest_cache/

# Archivos de sistema
.DS_Store
*.swp

# Checkpoints pesados (opcional, si no quieres subir archivos .pt de varios MB)
# checkpoints/*.pt
EOF# Excluir datasets pesados y checkpoints binarios de la GPU
data/
checkpoints/*.pt
checkpoints/*.pt
data/

# Pesos de modelos binarios (>100MB)
checkpoints/*.pt
*.pt

# Ignorar checkpoints y archivos pesados (>100MB)
*.pt
*.bin
*.tar.gz
*.zip
checkpoints/*.pt
checkpoints/*.tar.gz
data/*.json

#excluir tex
# Excluir fuentes LaTeX locales
docs/*.tex
*.tex
